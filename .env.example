# Instagram username without the @ symbol.
INSTAGRAM_CREATOR_USERNAME=creator_username_here

# Start conservatively. Five minutes is recommended during development.
POLL_INTERVAL_SECONDS=300

# Keep false while developing so browser behavior is visible.
HEADLESS=false

# Telegram secrets from BotFather and getUpdates.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789

# If true, send links that could not be classified for manual review.
NOTIFY_UNCERTAIN=true
ALERT_ALL_NEW_LINKS=false

# Local-only archive dashboard: http://127.0.0.1:4317
DASHBOARD_PORT=4317

# Optional: after each poll, publish job listings to feed/listings.json and push
# that file to GitHub with this machine's git credentials. In a public repo the
# feed is public. See README.md before enabling.
FEED_EXPORT_ENABLED=false
FEED_RETENTION_DAYS=14
